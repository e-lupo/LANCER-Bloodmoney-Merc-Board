<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>LANCER Job Board - Operational Theaters</title>
  <link rel="stylesheet" href="/css/terminal.css">
  <link rel="stylesheet" href="/css/currency.css">
  <link rel="stylesheet" href="/css/client.css">
  <link rel="stylesheet" href="/css/theaters.css">
</head>
<body class="<%= colorScheme %>">
  <div class="terminal-header">
    <div class="terminal-header-left">
      <h1>> <span id="portal-heading"><%= settings.portalHeading %></span> - OPERATIONAL THEATERS_</h1>
      <p>> USER_GROUP: <span id="user-group"><%= settings.userGroup %></span>_</p>
      <p>> ACTIVE_THEATERS: <span id="theaters-count">0</span>_</p>
      <a href="/client/overview" class="terminal-link">[OVERVIEW]</a>
    </div>
    <div class="terminal-header-right">
      <p class="terminal-info">> UNT: <span id="unt"><%= settings.unt %></span>U</p>
      <p class="terminal-info">> CURRENT_GALACTIC_POS: <span id="galactic-pos"><%= settings.currentGalacticPos %></span></p>
    </div>
  </div>

  <main class="client-theaters-container">
    <div class="client-theater-grid" id="theater-list">
      <!-- Populated by JavaScript -->
    </div>

    <section id="selected-theater-section" class="selected-theater-section" aria-hidden="true">
      <h2 class="selected-theater-label">> SELECTED_OPERATIONAL_THEATER_</h2>
      <div class="client-theater-workspace">
        <div class="client-theater-map-card">
          <div class="theater-map-viewport empty" id="theater-viewport">
            <span>> SELECT_OPERATIONAL_THEATER_</span>
          </div>
        </div>

        <aside class="theater-location-panel client-theater-info-card" id="theater-location-panel">
          <h3 id="theater-location-name"></h3>
          <div class="client-theater-galactic-pos client-theater-detail-galactic-pos" id="theater-detail-galactic-pos"></div>
          <button type="button" class="client-theater-back-link" id="theater-back-btn" hidden>[THEATER]</button>
          <div class="client-theater-divider"></div>
          <div class="client-theater-field-label">DESCRIPTION:</div>
          <p id="theater-location-description"></p>
          <div id="theater-child-link-container" class="client-theater-child-link" hidden>
            <button class="nav-button" id="theater-child-link-btn">> ZOOM_INTO_SUBLOCATION</button>
          </div>
          <h4 id="theater-detail-list-heading"></h4>
          <div class="theater-assigned-jobs" id="theater-assigned-jobs"></div>
        </aside>
      </div>
    </section>
  </main>

  <!-- Job Details Modal (reuses shared handlers) -->
  <div id="job-details-modal" class="modal-overlay">
    <div class="modal-content">
      <div class="modal-header">
        <h2>JOB DETAILS</h2>
        <button class="modal-close" onclick="closeModal('job-details-modal')">[X]</button>
      </div>
      <div class="modal-body">
        <div id="job-details-container"></div>
      </div>
    </div>
  </div>

  <!-- Voting Modal (same interface as the job board) -->
  <div id="voting-modal" class="modal-overlay">
    <div class="modal-content">
      <div class="modal-header">
        <h2>VOTING INTERFACE</h2>
        <button class="modal-close" onclick="closeVotingModal()">[X]</button>
      </div>
      <div class="modal-body">
        <p class="voting-instruction">> EACH PILOT MAY ONLY VOTE FOR ONE JOB.</p>
        <p class="voting-instruction">> SELECT A PILOT TO CAST THEIR VOTE:</p>
        <div class="pilots-list" id="voting-pilots-list">
          <!-- Populated by JavaScript -->
        </div>
        <p id="vote-warning" class="vote-warning" style="display: none;"></p>
        <div class="modal-actions">
          <button class="modal-button confirm-button" id="cast-vote-btn" onclick="confirmVote()" disabled>
            [CAST_VOTE]
          </button>
          <button class="modal-button cancel-button" onclick="closeVotingModal()">
            [CANCEL]
          </button>
        </div>
      </div>
    </div>
  </div>

  <script src="/js/shared-handlers.js"></script>
  <script>
    if (typeof currentCurrencyIcon !== 'undefined') {
      currentCurrencyIcon = '<%= settings.currencyIcon || "manna_symbol.svg" %>';
    }
  </script>
  <script src="/js/theaters-shared.js"></script>
  <script src="/js/sse-client.js"></script>
  <script src="/js/client-theaters.js"></script>
</body>
</html>